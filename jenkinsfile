pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo "Getting code from GitHub..."
                checkout scm
            }
        }

        stage('Run Unit Tests') {
            steps {
                echo "Running Maven unit tests..."
                sh 'mvn test'
            }
        }

    }

    post {
        success {
            echo "Unit tests passed successfully!"
        }

        failure {
            echo "Unit tests failed!"
        }
    }
}
